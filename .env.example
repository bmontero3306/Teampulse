# Copiar a .env y ajustar. El arranque local funciona sin .env (hay valores por defecto).
SECRET_KEY=cambiar-en-produccion
DEBUG=True
DEFAULT_FROM_EMAIL=noreply@teampulse.local
# Producción: DEBUG=False y lista de hosts separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1
# En Render no hace falta: se completa con RENDER_EXTERNAL_HOSTNAME.
# CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com
# Origen de la SPA para el enlace de recuperar clave y CORS.
FRONTEND_ORIGIN=http://localhost:4200
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
